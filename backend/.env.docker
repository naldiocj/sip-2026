# SIP Backend — variáveis de ambiente (Docker Compose)

APP_NAME=SIP — Sistema de Instrução Processual
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://sip:sip@postgres:5432/sip
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://sip:sip@rabbitmq:5672/

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sip
MINIO_SECRET_KEY=sip-secret
MINIO_SECURE=false

OPENSEARCH_URL=http://opensearch:9200

CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:80"]

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=sip-backend
