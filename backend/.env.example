# SIP Backend — variáveis de ambiente (nunca colocar secrets reais no Git)

# Aplicação
APP_NAME=SIP — Sistema de Instrução Processual
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://sip:sip@postgres:5432/sip

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://sip:sip@rabbitmq:5672/

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sip
MINIO_SECRET_KEY=sip-secret
MINIO_SECURE=false

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200

# CORS (JSON array)
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

# Observabilidade (OTLP; deixar vazio para desactivar traces)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=sip-backend

# Autenticação (JWT)
# JWT_SECRET é um secret — em produção usar valor gerado (openssl rand -hex 32)
JWT_SECRET=dev-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=sip-backend
JWT_AUDIENCE=sip-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_TTL_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=sip_access_token

# Rate limiting de autenticação
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900